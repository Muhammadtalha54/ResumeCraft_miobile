# ==================== STRIPE SANDBOX PUBLISHABLE KEY ====================
# Found in Stripe Dashboard -> Developers -> API keys -> Publishable key (starts with pk_test_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_sandbox_publishable_key_here

# ==================== API BASE URL (OPTIONAL OVERRIDE) ====================
# Leave empty to automatically use defaults:
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator / Desktop: http://localhost:5000/api
# - Physical Wi-Fi device: http://192.168.x.x:5000/api
API_BASE_URL=
